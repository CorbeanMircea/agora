{
  "name": "@agora/server",
  "version": "0.1.0",
  "private": true,
  "description": "AGORA platform server - Fastify + Socket.IO",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --testPathPattern=src/ --forceExit"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-socket.io": "^5.1.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.7.5",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}