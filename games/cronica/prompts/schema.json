{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://agora.local/schemas/prompt-pack.json",
    "title": "PromptPack",
    "description": "AGORA prompt pack schema — validates a complete set of prompts for use in a game module.",
    "type": "object",
    "required": [
        "id",
        "name",
        "version",
        "prompts"
    ],
    "additionalProperties": false,
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "Unique identifier for the pack, e.g. 'cronica_base'."
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "description": "Display name (Romanian)."
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Semantic version string, e.g. '1.0.0'."
        },
        "prompts": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/PromptEntry"
            }
        }
    },
    "$defs": {
        "PromptEntry": {
            "type": "object",
            "required": [
                "id",
                "text",
                "category",
                "safeMode",
                "minPlayers"
            ],
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$",
                    "description": "Globally unique identifier within the pack, e.g. 'cronica_001'."
                },
                "text": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 300,
                    "description": "The prompt text shown to players (Romanian)."
                },
                "category": {
                    "type": "string",
                    "enum": [
                        "relatie",
                        "munca",
                        "familie",
                        "situatie_absurda",
                        "scandal_de_bloc",
                        "decizie_proasta",
                        "secret",
                        "aventura",
                        "ambitie",
                        "infuntare"
                    ],
                    "description": "Thematic category."
                },
                "safeMode": {
                    "type": "boolean",
                    "description": "When true, safe for all audiences. When false, excluded in Safe Mode."
                },
                "minPlayers": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 8,
                    "description": "Minimum number of players required for this prompt to make sense."
                }
            }
        }
    }
}