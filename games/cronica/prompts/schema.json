{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://agora.local/schemas/prompt-pack.json",
    "title": "PromptPack",
    "description": "AGORA ingredient question pack schema.",
    "type": "object",
    "required": [
        "id",
        "name",
        "version",
        "prompts"
    ],
    "additionalProperties": false,
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "prompts": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/PromptEntry"
            }
        }
    },
    "$defs": {
        "PromptEntry": {
            "type": "object",
            "required": [
                "id",
                "text",
                "category",
                "safeMode",
                "minPlayers"
            ],
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$"
                },
                "text": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 300
                },
                "category": {
                    "type": "string",
                    "enum": [
                        "CONCRET",
                        "ABSTRACT",
                        "ACTIUNE",
                        "LOC",
                        "NUMAR",
                        "PROPRIU",
                        "ATRIBUT"
                    ]
                },
                "safeMode": {
                    "type": "boolean"
                },
                "minPlayers": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 8
                }
            }
        }
    }
}